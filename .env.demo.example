# Legacy isolated demo instance — synthetic data only. No YClients/SMTP/Sheets/Metabase.
# The normal demo flow is embedded in the main DB via `python -m scripts.seed_demo`.
# Copy to .env.demo only if you intentionally use docker-compose.demo.yml.

# Non-production env: skips the prod fail-closed validation so the stack boots
# with these defaults. Keep it out of {prod, production}.
APP_ENV=demo

# Demo database (isolated from production). DEMO_* are the host port bindings for
# the demo stack so they don't clash with the production compose stack.
DB_HOST=localhost
DB_PORT=5434
DB_NAME=demo_db
DB_USER=postgres
DB_PASSWORD=change_me_demo_db_password
DB_BATCH_SIZE=1000
DEMO_DB_PORT=5434
DEMO_API_PORT=8001

# API
API_HOST=0.0.0.0
API_PORT=8000
# Demo uses passwordless login only — no global API key.
API_KEY=

# Portal auth. Own JWT secret so demo sessions are isolated from production.
# Public demo: still set a strong random AUTH_JWT_SECRET (32+ chars).
AUTH_JWT_SECRET=change_me_demo_jwt_secret_min_32_chars
AUTH_JWT_EXPIRE_MINUTES=90
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_REQUIRE_LOGIN=true
AUTH_PUBLIC_REGISTRATION_ENABLED=false
AUTH_EMAIL_VERIFY_REQUIRED=false
# Set AUTH_COOKIE_SECURE=true when the demo is served over HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_CSRF_COOKIE_NAME=portal_csrf
AUTH_CSRF_HEADER_NAME=X-CSRF-Token
PORTAL_CREDENTIALS_ENCRYPTION_KEY=change_me_demo_encryption_secret
# Public URL of the demo SPA (used in links). Set to the demo origin.
APP_PUBLIC_URL=http://127.0.0.1:8001

# Unused by the demo (no sync), kept empty.
SYNC_API_TOKEN=

# CORS: set to the demo SPA origin if the frontend is served on another host.
DASHBOARD_CORS_ORIGINS=
DASHBOARD_CORS_ORIGIN_REGEX=

# Email disabled (the demo owner is a synthetic, non-deliverable address).
AUTH_CONSOLE_EMAIL=true
