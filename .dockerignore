.env*
!.env.example
.DS_Store
# Protective patterns: a key file dropped into the tree must never be baked into an image layer.
*service*account*.json
secrets/*.json
.git
.github
.venv
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
logs/
# Not needed at runtime: the SPA is built in CI and served by the VM's nginx; the tests, docs and dev tooling
# are for development. scripts/ stays: migrate.py imports scripts.bootstrap_db.
web/
deploy/
tests/
*.md
ruff.toml
pytest.ini
.gitleaks.toml
requirements-dev.txt
