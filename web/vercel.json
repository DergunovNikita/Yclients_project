{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "installCommand": "npm ci",
  "functions": {
    "api/auth-proxy.js": { "maxDuration": 180 },
    "api/auth/**/*.js": { "maxDuration": 180 },
    "api/dashboard/**/*.js": { "maxDuration": 180 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; script-src 'self'" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/auth/:path*", "destination": "/api/auth-proxy?path=:path*" },
    { "source": "/api/auth/:path*", "destination": "/api/auth-proxy?path=:path*" },
    { "source": "/dashboard/payments/:path*", "destination": "/api/auth-proxy?scope=dashboard&path=payments/:path*" },
    { "source": "/api/dashboard/payments/:path*", "destination": "/api/auth-proxy?scope=dashboard&path=payments/:path*" },
    { "source": "/dashboard/:path*", "destination": "/api/dashboard/:path*" },
    { "source": "/onboarding/:path*", "destination": "/api/auth-proxy?scope=onboarding&path=:path*" },
    { "source": "/api/onboarding/:path*", "destination": "/api/auth-proxy?scope=onboarding&path=:path*" },
    { "source": "/settings", "destination": "/settings.html" },
    { "source": "/reports", "destination": "/index.html" },
    { "source": "/reports/:path*", "destination": "/index.html" }
  ]
}
