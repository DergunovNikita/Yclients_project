# Browser-visible API base.
VITE_API_BASE=/api

# Direct browser API mode for local/private deployments:
# VITE_API_BASE=https://api.example.com

# Embedded demo tenant:
# Leave VITE_DEMO_ORIGIN unset so "View demo" performs same-origin /auth/demo-login.
# VITE_DEMO_ORIGIN is only for legacy separate demo-site deployments.

# Show the "create account" link on the login page. Leave unset in production, where the API
# refuses public registration; set to true for dev/demo builds that run with registration enabled.
# VITE_PUBLIC_REGISTRATION=true
