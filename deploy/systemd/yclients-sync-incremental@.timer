[Unit]
Description=Run YClients BI incremental sync hourly by day, every 4 hours at night

[Timer]
# Moscow time: hourly while the branches work, then 02:35 and 06:35.
OnCalendar=*-*-* 08..22:35:00 Europe/Moscow
OnCalendar=*-*-* 02,06:35:00 Europe/Moscow
Persistent=true
Unit=yclients-sync-incremental@%i.service

[Install]
WantedBy=timers.target
