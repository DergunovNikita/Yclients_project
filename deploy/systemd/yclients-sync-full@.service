[Unit]
Description=YClients BI weekly full sync
After=network.target docker.service
Wants=network.target

[Service]
Type=oneshot
# Exit 75 means another sync held the advisory lock; that is a skip, not a failure.
SuccessExitStatus=75
User=%i
WorkingDirectory=/opt/yclients_bi_system
ExecStart=/opt/yclients_bi_system/sync.sh full scheduled systemd
