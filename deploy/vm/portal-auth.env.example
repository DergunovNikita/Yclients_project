# Append to /opt/yclients_bi_system/.env (requires root).
# Generate secrets with: openssl rand -hex 32

APP_ENV=production
AUTH_JWT_SECRET=replace_with_real_openssl_rand_hex_32
AUTH_REQUIRE_LOGIN=true
AUTH_EMAIL_VERIFY_REQUIRED=false
APP_PUBLIC_URL=https://yclients-project.vercel.app
AUTH_CONSOLE_EMAIL=false
AUTH_COOKIE_SECURE=true
SYNC_API_TOKEN=replace_with_real_openssl_rand_hex_32
PORTAL_CREDENTIALS_ENCRYPTION_KEY=replace_with_real_openssl_rand_hex_32

# Production email delivery is required; console email is rejected in production.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=mailer@example.com
SMTP_PASSWORD=replace_with_real_smtp_app_password
SMTP_FROM=mailer@example.com
SMTP_USE_SSL=true
SMTP_USE_TLS=true

# Optional bootstrap (used by scripts/deploy_portal_vm.sh):
# PORTAL_ADMIN_EMAIL=you@company.com
# PORTAL_ADMIN_PASSWORD=strong_password_here
# PORTAL_ADMIN_NAME=Super Admin
# PORTAL_EXTRA_ADMIN_EMAILS=dergunovnt@yandex.ru
# PORTAL_EXTRA_ADMIN_NAME=Nikita Super Admin
# PORTAL_CREATE_DERGUNOV_ADMIN=true
# PORTAL_DERGUNOV_ADMIN_EMAIL=dergunovnt@yandex.ru
# PORTAL_DERGUNOV_ADMIN_NAME=Nikita Super Admin
# PORTAL_PROVISION_STAFF=false
