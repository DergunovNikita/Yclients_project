# Append to /opt/yclients_bi_system/.env (requires root).
# Generate secrets with: openssl rand -hex 32

APP_ENV=production
AUTH_JWT_SECRET=replace_with_real_openssl_rand_hex_32
AUTH_REQUIRE_LOGIN=true
AUTH_EMAIL_VERIFY_REQUIRED=false
APP_PUBLIC_URL=https://your-domain.example
AUTH_CONSOLE_EMAIL=false
AUTH_ALLOW_CONSOLE_EMAIL_IN_PRODUCTION=false
AUTH_COOKIE_SECURE=true
SYNC_API_TOKEN=replace_with_real_openssl_rand_hex_32
PORTAL_CREDENTIALS_ENCRYPTION_KEY=replace_with_real_openssl_rand_hex_32
# Same value as the X-Proxy-Secret the site's nginx sends. Lets the API believe X-Forwarded-For from it, so the
# login rate limit and session IPs are per visitor. Empty = per proxy address.
PROXY_SHARED_SECRET=replace_with_real_openssl_rand_hex_32

# Production email delivery is required by default.
# Temporary fallback without SMTP: set AUTH_CONSOLE_EMAIL=true and
# AUTH_ALLOW_CONSOLE_EMAIL_IN_PRODUCTION=true; auth emails are then not delivered at all (only
# recipient and subject are logged in production, never the link).
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=mailer@example.com
SMTP_PASSWORD=replace_with_real_smtp_app_password
SMTP_FROM=mailer@example.com
SMTP_USE_SSL=true
SMTP_USE_TLS=true

# Optional bootstrap (used by deploy/vm/yclients-auto-deploy.sh). Create-only: an existing user is
# skipped, so a password changed in the portal survives deploys. To overwrite one by hand:
#   docker compose run --rm --no-deps --entrypoint python api create_portal_admin.py \
#     --email you@company.com --reset-password   (password from PORTAL_ADMIN_PASSWORD)
# PORTAL_ADMIN_EMAIL=you@company.com
# PORTAL_ADMIN_PASSWORD=strong_password_here
# PORTAL_ADMIN_NAME=Super Admin
# Comma-separated, same password; same create-only rule
# PORTAL_EXTRA_ADMIN_EMAILS=second@company.com
# PORTAL_EXTRA_ADMIN_NAME=Portal Admin
