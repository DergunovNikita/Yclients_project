# YClients credentials are not configured here: they are stored encrypted in
# system.yclients_credentials through onboarding/admin.
# Anything not in NON_PRODUCTION_ENV_NAMES (config.py) is treated as production and must
# pass validate_production_config(); an unset or misspelled value fails closed on purpose.
APP_ENV=local
YCLIENTS_REQUEST_DELAY=0.25
YCLIENTS_TIMEOUT=30
YCLIENTS_RETRY_TOTAL=3
YCLIENTS_RETRY_BACKOFF=1.0
# Cap (seconds) on a 429 Retry-After the client honors.
YCLIENTS_RETRY_AFTER_MAX=60

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=yclients_db
DB_USER=postgres
DB_PASSWORD=changeme
DB_BATCH_SIZE=1000

# Sync windows
SYNC_DAYS=0
SYNC_HISTORY_START_DATE=2000-01-01
SCHEDULE_DAYS=60
SYNC_INCREMENTAL=true
SYNC_LOOKBACK_DAYS=2
SYNC_REFRESH_DAYS=90
# Retention for the bookkeeping tables nothing else prunes: sync_runs + sync_step_runs and
# sync_jobs + sync_job_events. Both sweeps run from the worker's idle branch and keep the
# latest row whatever its age; 0 disables either one.
SYNC_RUN_RETENTION_DAYS=30
SYNC_RUN_RETENTION_INTERVAL_HOURS=24
SYNC_JOB_RETENTION_DAYS=30
SYNC_JOB_RETENTION_INTERVAL_HOURS=24
# Report usage log (system.report_usage_events): swept by the worker on the same daily throttle; 0 keeps everything.
REPORT_USAGE_RETENTION_DAYS=400
SYNC_LOG_DIR=logs
SYNC_LOCK_ID=826451
SYNC_API_TOKEN=replace_with_32_plus_random_chars
SYNC_WORKER_POLL_INTERVAL=5
# When no sync has succeeded for N minutes the worker enqueues sync jobs itself (systemd timers
# may run alongside; the advisory lock keeps them from overlapping). false or 0 = timers/manual only.
SYNC_AUTO_ENQUEUE_ENABLED=true
SYNC_AUTO_ENQUEUE_INTERVAL_MINUTES=240
# A 'running' job older than this is treated as orphaned (worker died mid-sync).
SYNC_STALE_JOB_MINUTES=120
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=

# Optional: comma-separated exact origins for product dashboard SPA (Vercel), e.g. https://my-app.vercel.app
DASHBOARD_CORS_ORIGINS=
# Must stay empty in production (a regex is rejected by validate_production_config() and blocks API startup).
DASHBOARD_CORS_ORIGIN_REGEX=

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Portal auth (personal cabinets)
# Production: AUTH_REQUIRE_LOGIN=true, strong AUTH_JWT_SECRET (32+ chars), APP_PUBLIC_URL = SPA URL.
# Generate with: openssl rand -hex 32
AUTH_JWT_SECRET=replace_with_openssl_rand_hex_32
# Short-lived access token; refresh-token flow rotates it.
AUTH_JWT_EXPIRE_MINUTES=90
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=30
# Per user; oldest sessions are invalidated and removed automatically. Minimum: 1.
AUTH_MAX_ACTIVE_SESSIONS=15
# Hard ceiling on a session's life from the day it was created; rotation slides expiry only up to it.
AUTH_SESSION_MAX_AGE_DAYS=90
AUTH_REQUIRE_LOGIN=true
# Enabled by default only in local/test; production must set false.
AUTH_PUBLIC_REGISTRATION_ENABLED=true
AUTH_EMAIL_VERIFY_REQUIRED=true
# Throttle for /forgot-password and verification resend.
AUTH_EMAIL_RESEND_COOLDOWN_SECONDS=60
# HttpOnly session cookies. Local HTTP needs false; production HTTPS must override to true.
AUTH_COOKIE_SECURE=false
# Production normally requires SMTP. Set this only for an explicit degraded console-email fallback.
AUTH_ALLOW_CONSOLE_EMAIL_IN_PRODUCTION=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_CSRF_COOKIE_NAME=portal_csrf
AUTH_CSRF_HEADER_NAME=X-CSRF-Token
# Auth rate limit within the window: per (e-mail, IP) pair, and per IP (defaults to 5x the first).
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# AUTH_RATE_LIMIT_IP_MAX_REQUESTS=50
# Shared secret between the Vercel proxy (VM_PROXY_SECRET there, same value) and this API. A request that
# carries it as X-Proxy-Secret is trusted about the visitor's address in X-Forwarded-For (rate limits,
# session ip_hash); without it the socket peer is used. Production: 32+ chars, or leave empty.
# Generate with: openssl rand -hex 32
PROXY_SHARED_SECRET=
# Used to encrypt admin-managed YClients credentials stored in PostgreSQL.
# Production: set a long random secret and keep it stable.
PORTAL_CREDENTIALS_ENCRYPTION_KEY=replace_with_fernet_or_32_plus_random_chars
# Optional: previous key used during a rotation window. New writes use the primary key.
PORTAL_CREDENTIALS_ENCRYPTION_KEY_OLD=
# Public URL of the SPA (links in emails). Production: https://your-domain.com
APP_PUBLIC_URL=http://127.0.0.1:5173

# Email: confirmation & password reset
# Local default prints verification/reset links to the API console.
# Production must configure SMTP and set AUTH_CONSOLE_EMAIL=false.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=true
# Gmail: smtp.gmail.com, port 587, SMTP_USE_SSL=false, SMTP_USE_TLS=true, app password
# Mail.ru: smtp.mail.ru, port 465, SMTP_USE_SSL=true
AUTH_CONSOLE_EMAIL=true
