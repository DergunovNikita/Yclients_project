{
  "installCommand": "cd web && npm install",
  "buildCommand": "cd web && npm run build",
  "outputDirectory": "web/dist",
  "framework": null,
  "functions": {
    "api/auth-proxy.js": { "maxDuration": 30 },
    "api/dashboard/**/*.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/auth/admin/yclients-credentials", "destination": "/api/auth/admin/yclients-credentials" },
    { "source": "/auth/admin/yclients-credentials/test", "destination": "/api/auth/admin/yclients-credentials/test" },
    { "source": "/auth/admin/yclients-credentials/:credential_id", "destination": "/api/auth/admin/yclients-credentials/:credential_id" },
    { "source": "/auth/admin/yclients-credentials/:credential_id/test", "destination": "/api/auth/admin/yclients-credentials/:credential_id/test" },
    { "source": "/auth/:path*", "destination": "/api/auth-proxy?path=:path*" },
    { "source": "/api/auth/:path*", "destination": "/api/auth-proxy?path=:path*" },
    { "source": "/dashboard/:path*", "destination": "/api/dashboard/:path*" },
    { "source": "/onboarding/:path*", "destination": "/api/onboarding/:path*" },
    { "source": "/settings", "destination": "/settings.html" },
    { "source": "/reports", "destination": "/index.html" },
    { "source": "/reports/:path*", "destination": "/index.html" }
  ]
}
