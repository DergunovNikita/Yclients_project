{
  "installCommand": "cd web && npm install",
  "buildCommand": "cd web && npm run build",
  "outputDirectory": "web/dist",
  "framework": null,
  "rewrites": [
    { "source": "/auth/:path*", "destination": "/api/auth-proxy?path=:path*" },
    { "source": "/api/auth/:path*", "destination": "/api/auth-proxy?path=:path*" },
    { "source": "/dashboard/:path*", "destination": "/api/dashboard/:path*" },
    { "source": "/settings", "destination": "/settings.html" },
    { "source": "/reports", "destination": "/index.html" },
    { "source": "/reports/:path*", "destination": "/index.html" }
  ]
}
